# Puerto del servidor
PORT=4000

# Secreto para firmar los JWT (cambiar en producción por un valor largo y aleatorio)
JWT_SECRET=cambia-este-valor-en-produccion

# Credenciales del administrador (SOLO PARA DESARROLLO/DEMO)
# En producción: eliminar estas variables y usar una tabla de usuarios admin
# real con contraseñas hasheadas y, si aplica, doble factor de autenticación.
ADMIN_EMAIL=admin@conectaoficios.com
ADMIN_PASSWORD=Admin1234!

# Si es "true", los profesionales deben confirmar su email antes de operar.
# El administrador NUNCA pasa por este flujo: inicia sesión con usuario/clave
# directamente, ya que es una cuenta de sistema, no una cuenta que se registra.
REQUIRE_EMAIL_VERIFICATION=true

# Habilita el botón de "acceso rápido demo" en /admin-login (solo entornos NO productivos)
ENABLE_DEMO_LOGIN_BUTTON=true
NODE_ENV=development
